{
  "name": "mattermost-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP tools for Mattermost browser-session authentication and read-only API access",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "login": "node dist/desktop-login.js",
    "check": "npm run build && npm test",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
